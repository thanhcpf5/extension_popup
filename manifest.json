{
  "manifest_version": 3,
  "name": "Hướng Dẫn Dịch Vụ Công",
  "version": "1.0",
  "description": "Provides a step-by-step tutorial.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://dichvucong.bocongan.gov.vn/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["steps.json"],
      "matches": [
        "https://dichvucong.bocongan.gov.vn/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dichvucong.bocongan.gov.vn/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "scripts/text-to-speech.js",
        "scripts/validate.js",
        "scripts/content.js"
      ],
      "css": ["styles/styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
